# Copy this to .env.live and fill real values locally.
# Do not commit your filled env file.

POLYBOT_ENABLE_LIVE_TRADING=YES
POLYMARKET_PRIVATE_KEY=

# Optional cached L2 API credentials.
# If these are blank/omitted, the bot derives them from POLYMARKET_PRIVATE_KEY at startup.
# If you provide one, provide all three.
# CLOB_API_KEY=
# CLOB_SECRET=
# CLOB_PASS_PHRASE=

# Optional proxy/safe wallet settings.
# POLYMARKET_SIGNATURE_TYPE=1
# POLYMARKET_FUNDER_ADDRESS=0x...
# POLYMARKET_CHAIN_ID=137

# Bot runtime.
POLYBOT_ASSETS=BTC
POLYBOT_CYCLES=0
POLYBOT_POLL_SECONDS=3
POLYBOT_DB=live_trades_jetfadil_prod
POLYBOT_STORAGE=csv
POLYBOT_STRATEGY_MODE=jetfadil

# Local ledger/accounting baseline only. Live mode reads real CLOB balance separately.
POLYBOT_BALANCE=300
POLYBOT_MAX_MARKET_NOTIONAL=18
POLYBOT_MAX_SINGLE_FILL=3
POLYBOT_MAX_UNPAIRED_NOTIONAL=2
POLYBOT_MIN_ORDER_NOTIONAL=1

# Profitable v4 JetFadil config.
POLYBOT_PROFIT_EXPANSION_PAIR_COST=0.98
POLYBOT_JETFADIL_ENTRY_PAIR_COST=0.98
POLYBOT_JETFADIL_EARLY_ENTRY_PAIR_COST=0.95
POLYBOT_JETFADIL_DEEP_VALUE_PAIR_COST=0.95
POLYBOT_JETFADIL_MIN_ENTRY_SECONDS=60
POLYBOT_JETFADIL_MIN_CONFIDENCE=0.05
POLYBOT_JETFADIL_STRONG_TILT_CONFIDENCE=0.50
POLYBOT_JETFADIL_MAX_DIRECTIONAL_BIAS=0.10
POLYBOT_JETFADIL_STARTER_ENTRY_CUTOFF_SECONDS=240
POLYBOT_JETFADIL_CORE_PAIR_FRACTION=0.80
POLYBOT_JETFADIL_PRE_LATE_EXPANSION_PAIR_COST=0.85
POLYBOT_JETFADIL_LATE_EXPANSION_SECONDS=240

# Production wrapper.
POLYBOT_RESOLUTION_GRACE_SECONDS=20
POLYBOT_RESOLUTION_POLL_SECONDS=30
POLYBOT_BAD_REGIME_WINDOW=20
POLYBOT_BAD_REGIME_MIN_COMPLETION_RATE=0.50
POLYBOT_DISABLE_BAD_REGIME_GUARD=false
POLYBOT_LIVE_ORDER_TYPE=FAK
POLYBOT_LIVE_TICK_SIZE=0.01
POLYBOT_LIVE_PRICE_TICKS=1
